doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  title Reset Your Password
  style.
    body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    color: #333;
    background-color: #f5f5f5; 
    }
    table {
    width: 100%; 
    max-width: 600px;
    margin: 20px auto; 
    border-collapse: collapse; 
    }
    td {
    padding: 15px;
    text-align: center; 
    }
    h1 {
    margin: 0;
    font-size: 24px;
    color: #333;
    }
    p {
    margin: 10px 0;
    }
    a {
    color:white !important;
    text-decoration: none;
    padding: 10px 20px;
    background-color: #007bff;
    border-radius: 5px;
    display: inline-block; 
    }
    .cta {
    display: inline-block;
    padding: 10px 20px;
    background-color: #414EF9;
    color: #fff;
    font-weight: bold;
    border-radius: 5px;
    margin-top: 20px;
    text-decoration: none;
    color:white !important;
    }
    .logo {
    height: auto;
    width: 200px;
    margin-bottom: 20px;
    background-color:black !important;
    }
table
  tr
    td(style='background-color: #fff; padding: 30px;')
      .header
        img.logo(src='http://ogmr.ongraph.com:5000/assets/images/ong-white.png' alt='Logo')
      h1 Reset Your Password
      p You have requested a password reset for your account.
      p Please click the link below to reset your password:
      a.cta(href=frontendurl) Reset Password
      p This link will expire in 15 minutes.
      p If you did not request a password reset, please ignore this email.
|   &grave;
